{
  "name": "pdf-convertor",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "npm --prefix client run dev",
    "build": "tsc && npm --prefix client run build",
    "test": "tsx tests/extraction.test.ts && tsx tests/e2e.test.ts && tsx tests/phase2-reliability.test.ts && tsx tests/provenance-transform.test.ts",
    "test:unit": "tsx tests/extraction.test.ts",
    "test:e2e": "tsx tests/e2e.test.ts",
    "test:reliability": "tsx tests/phase2-reliability.test.ts",
    "test:provenance": "tsx tests/provenance-transform.test.ts",
    "test:corpus": "tsx tests/utils/synthetic-stress-builder.ts",
    "test:eval": "tsx tests/evaluation-runner.ts",
    "groundtruth": "tsx tests/utils/groundtruth-tool.ts",
    "benchmark": "tsx tests/benchmark.test.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonrepair": "^3.15.0",
    "multer": "^2.3.0",
    "openai": "^7.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  }
}
